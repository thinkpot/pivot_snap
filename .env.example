NEXT_PUBLIC_SITE_URL=https://pivotsnap.tech

# Whop Checkout
NEXT_PUBLIC_WHOP_PLAN_ID=plan_replace_me

# Resend transactional email - placeholders only. Do not commit real keys.
RESEND_API_KEY=replace_me_resend_api_key
RESEND_FROM_EMAIL=code@pivotsnap.tech
SUPPORT_EMAIL=support@pivotsnap.tech

# Optional lead capture webhook for /api/subscribe.
EMAIL_CAPTURE_WEBHOOK_URL=

# Postgres for storing /demo email signups (a "signups" table, upserted by
# email). Works with any standard Postgres connection string - created via
# the Vercel project's Storage tab (Prisma Postgres, Neon, Supabase, etc.),
# which auto-fills this env var. Run `vercel env pull .env.local` to get it
# locally, or leave unset to skip DB storage (still hits the webhook above).
DATABASE_URL=

# Legacy Stripe variables are no longer used by the pricing button, but old Stripe routes remain in code for reference until removed.
STRIPE_SECRET_KEY=replace_me_legacy_stripe_secret_key
STRIPE_PRICE_ID=price_replace_me_for_one_time_10_usd_product
STRIPE_WEBHOOK_SECRET=replace_me_legacy_stripe_webhook_secret
