ai_bias_text(_bias) =>
    _bias == 1 ? "BULL" : _bias == -1 ? "BEAR" : "NEUTRAL"

ai_bias_color(_bias) =>
    _bias == 1 ? color.new(#00C2A8, 0) : _bias == -1 ? color.new(#F25F5C, 0) : color.new(color.gray, 30)

scanner_text(_sig) =>
    na(_sig) ? "N/A" : _sig == 1 ? "BUY" : _sig == -1 ? "SELL" : _sig == 2 ? "Bull" : _sig == -2 ? "Bear" : "Wait"

scanner_color(_sig) =>
    na(_sig) ? color.new(color.gray, 30) : _sig == 1 ? color.new(#00C2A8, 0) : _sig == -1 ? color.new(#F25F5C, 0) : _sig == 2 ? color.new(#00C2A8, 72) : _sig == -2 ? color.new(#F25F5C, 72) : color.new(color.gray, 84)

price_text(_price) =>
    na(_price) ? "-" : str.tostring(_price, "#.##")

confidence_text(_confidence) =>
    na(_confidence) ? "-" : str.tostring(_confidence, "#") + "%"

update_scanner_row(_tbl, _row, _symbol, _sig, _confidence, _lastClose) =>
    _sigColor = scanner_color(_sig)
    table.cell(_tbl, 0, _row, _symbol, text_color=color.white, bgcolor=color.new(color.black, 18), text_size=size.small)
    table.cell(_tbl, 1, _row, scanner_text(_sig), text_color=color.white, bgcolor=_sigColor, text_size=size.small)
    table.cell(_tbl, 2, _row, confidence_text(_confidence), text_color=color.white, bgcolor=color.new(color.black, 18), text_size=size.small)
    table.cell(_tbl, 3, _row, price_text(_lastClose), text_color=color.white, bgcolor=color.new(color.black, 18), text_size=size.small)

[scanSignal1, scanConfidence1, scanClose1] = request.security(index1Symbol, scannerTf, scanner_signal(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[scanSignal2, scanConfidence2, scanClose2] = request.security(index2Symbol, scannerTf, scanner_signal(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[scanSignal3, scanConfidence3, scanClose3] = request.security(index3Symbol, scannerTf, scanner_signal(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[scanSignal4, scanConfidence4, scanClose4] = request.security(index4Symbol, scannerTf, scanner_signal(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[scanSignal5, scanConfidence5, scanClose5] = request.security(index5Symbol, scannerTf, scanner_signal(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

