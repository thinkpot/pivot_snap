    update_scanner_row(indexScanner, 5, index5Symbol, scanSignal5, scanConfidence5, scanClose5)
    table.cell(indexScanner, 0, 6, "Closed bars", text_color=color.gray, bgcolor=color.new(color.black, 8), text_size=size.tiny)
    table.cell(indexScanner, 1, 6, scannerTf, text_color=color.gray, bgcolor=color.new(color.black, 8), text_size=size.tiny)
    table.cell(indexScanner, 2, 6, "Min", text_color=color.gray, bgcolor=color.new(color.black, 8), text_size=size.tiny)
