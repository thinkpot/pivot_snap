alertcondition(slHitLong and confirmedSignalBar,  title='pivotsnap SL Hit Long',  message='pivotsnap SL HIT LONG | {{ticker}} @ {{close}} | {{interval}}')
alertcondition(tpHitShort and confirmedSignalBar, title='pivotsnap TP Hit Short', message='pivotsnap TP HIT SHORT | {{ticker}} @ {{close}} | {{interval}}')
alertcondition(slHitShort and confirmedSignalBar, title='pivotsnap SL Hit Short', message='pivotsnap SL HIT SHORT | {{ticker}} @ {{close}} | {{interval}}')

