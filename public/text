// Indian Index Scanner
scannerGroup        = "Indian Index Scanner"
showIndexScanner    = input.bool(true, "Show Bottom-Right Index Scanner", group=scannerGroup)
scannerTfInput      = input.timeframe("", "Scanner Timeframe", group=scannerGroup, tooltip="Blank uses the chart timeframe. Scanner values use closed candles only.")
scannerMinConfidence= input.int(70, "Scanner Confidence", group=scannerGroup, minval=1, maxval=100)
index1Symbol        = input.string("NSE:NIFTY", "Index 1", group=scannerGroup, tooltip="Use the exact TradingView ticker. If unavailable, the scanner row shows N/A instead of stopping the script.")
index2Symbol        = input.string("NSE:BANKNIFTY", "Index 2", group=scannerGroup)
index3Symbol        = input.string("NSE:CNXFINANCE", "Index 3", group=scannerGroup)
index4Symbol        = input.string("NSE:CNXIT", "Index 4", group=scannerGroup)
index5Symbol        = input.string("BSE:SENSEX", "Index 5", group=scannerGroup)
scannerTf           = scannerTfInput == "" ? timeframe.period : scannerTfInput

// ================================
// ==== TP/SL Settings (NEW) ====
// ================================
atrLength    = input.int(14,    "ATR Length",          group="TP/SL Settings", minval=1)
atrMultTP    = input.float(2.0, "TP ATR Multiplier",   group="TP/SL Settings", step=0.25, minval=0.25, tooltip="Take Profit = Entry ± ATR × this value")
atrMultSL    = input.float(1.0, "SL ATR Multiplier",   group="TP/SL Settings", step=0.25, minval=0.25, tooltip="Stop Loss = Entry ∓ ATR × this value")
showTPSL     = input.bool(true, "Show TP/SL Lines",    group="TP/SL Settings")
showEPLine   = input.bool(true, "Show Entry Price Line", group="TP/SL Settings")

// =================================
// ==== Next Bar Classification ====
// =================================

src = settings.source
y_train_series = src[4] < src[0] ? direction.short : src[4] > src[0] ? direction.long : direction.neutral
var y_train_array = array.new_int(0)

var predictions = array.new_float(0)
var prediction  = 0.
var signal      = direction.neutral
var distances   = array.new_float(0)

array.push(y_train_array, y_train_series)

// =========================
// ====  Core ML Logic  ====
// =========================

lastDistance = -1.0
size     = math.min(settings.maxBarsBack-1, array.size(y_train_array)-1)
sizeLoop = math.min(settings.maxBarsBack-1, size)

if bar_index >= maxBarsBackIndex
    for i = 0 to sizeLoop
        d = get_lorentzian_distance(i, settings.featureCount, featureSeries, featureArrays)
        if d >= lastDistance and i % 4 != 0
            lastDistance := d
            array.push(distances, d)
            array.push(predictions, math.round(array.get(y_train_array, i)))
            if array.size(predictions) > settings.neighborsCount
                lastDistance := array.get(distances, math.round(settings.neighborsCount*3/4))
                array.shift(distances)
                array.shift(predictions)
    prediction := array.sum(predictions)

// ============================
// ==== Prediction Filters ====
// ============================

filter_all = filter.volatility and filter.regime and filter.adx

signal := prediction > 0 and filter_all ? direction.long : prediction < 0 and filter_all ? direction.short : nz(signal[1])

var int barsHeld = 0
barsHeld := ta.change(signal) ? 0 : barsHeld + 1
isHeldFourBars        = barsHeld == 4
isHeldLessThanFourBars= 0 < barsHeld and barsHeld < 4

isDifferentSignalType = ta.change(signal)
isEarlySignalFlip     = ta.change(signal) and (ta.change(signal[1]) or ta.change(signal[2]) or ta.change(signal[3]))
isBuySignal           = signal == direction.long  and isEmaUptrend   and isSmaUptrend
isSellSignal          = signal == direction.short and isEmaDowntrend and isSmaDowntrend
isLastSignalBuy       = signal[4] == direction.long  and isEmaUptrend[4]   and isSmaUptrend[4]
isLastSignalSell      = signal[4] == direction.short and isEmaDowntrend[4] and isSmaDowntrend[4]
isNewBuySignal        = isBuySignal  and isDifferentSignalType
isNewSellSignal       = isSellSignal and isDifferentSignalType

// Kernel Regression
c_green     = color.new(#009988, 20)
c_red       = color.new(#CC3311, 20)
transparent = color.new(#000000, 100)
yhat1 = kernels.rationalQuadratic(settings.source, h, r, x)
yhat2 = kernels.gaussian(settings.source, h-lag, x)
kernelEstimate = yhat1

bool wasBearishRate = yhat1[2] > yhat1[1]
bool wasBullishRate = yhat1[2] < yhat1[1]
bool isBearishRate  = yhat1[1] > yhat1
bool isBullishRate  = yhat1[1] < yhat1
isBearishChange = isBearishRate and wasBullishRate
isBullishChange = isBullishRate and wasBearishRate

bool isBullishCrossAlert = ta.crossover(yhat2, yhat1)
bool isBearishCrossAlert = ta.crossunder(yhat2, yhat1)
bool isBullishSmooth     = yhat2 >= yhat1
bool isBearishSmooth     = yhat2 <= yhat1

color colorByCross = isBullishSmooth ? c_green : c_red
color colorByRate  = isBullishRate   ? c_green : c_red
color plotColor    = showKernelEstimate ? (useKernelSmoothing ? colorByCross : colorByRate) : transparent
plot(kernelEstimate, color=plotColor, linewidth=2, title="Kernel Regression Estimate")

bool alertBullish = useKernelSmoothing ? isBullishCrossAlert : isBullishChange
bool alertBearish = useKernelSmoothing ? isBearishCrossAlert : isBearishChange

isBullish = useKernelFilter ? (useKernelSmoothing ? isBullishSmooth : isBullishRate) : true
isBearish = useKernelFilter ? (useKernelSmoothing ? isBearishSmooth : isBearishRate) : true

// ===============================
// ==== pivotsnap AI Confluence ====
// ===============================

aiEmaFast = ta.ema(settings.source, aiFastEmaLen)
aiEmaSlow = ta.ema(settings.source, aiSlowEmaLen)
[aiMacdLine, aiMacdSignalLine, aiMacdHist] = ta.macd(settings.source, aiMacdFast, aiMacdSlow, aiMacdSignal)
aiRsi = ta.rsi(settings.source, aiRsiLen)
[aiSupertrend, aiSupertrendDirection] = ta.supertrend(aiStFactor, aiStPeriod)
[aiPlusDi, aiMinusDi, aiAdx] = ta.dmi(aiAdxLen, aiAdxLen)
aiVwap = ta.vwap(hlc3)
aiVolumeMa = ta.sma(volume, aiVolumeLen)
aiHasVolume = not na(volume) and volume > 0 and not na(aiVolumeMa) and aiVolumeMa > 0
aiVolumePass = not useAiVolumeFilter or not aiHasVolume or volume >= aiVolumeMa * aiVolumeMult

aiHtfClose = request.security(syminfo.tickerid, aiHtfTf, close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
aiHtfEma = request.security(syminfo.tickerid, aiHtfTf, ta.ema(close, aiHtfEmaLen)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
aiHtfReady = not na(aiHtfClose) and not na(aiHtfEma)

aiMlBull = prediction > 0
aiMlBear = prediction < 0
aiKernelBull = isBullish
aiKernelBear = isBearish
aiTrendBull = aiEmaFast > aiEmaSlow and close > aiEmaSlow
aiTrendBear = aiEmaFast < aiEmaSlow and close < aiEmaSlow
aiSuperBull = aiSupertrendDirection < 0
aiSuperBear = aiSupertrendDirection > 0
aiMacdBull = aiMacdHist > 0 and aiMacdLine > aiMacdSignalLine
aiMacdBear = aiMacdHist < 0 and aiMacdLine < aiMacdSignalLine
aiRsiBull = aiRsi >= 52
aiRsiBear = aiRsi <= 48
aiVwapBull = not useAiVwapFilter or na(aiVwap) or close > aiVwap
aiVwapBear = not useAiVwapFilter or na(aiVwap) or close < aiVwap
aiHtfBull = not useAiHtfConfirm or not aiHtfReady or aiHtfClose > aiHtfEma
aiHtfBear = not useAiHtfConfirm or not aiHtfReady or aiHtfClose < aiHtfEma
aiAdxPass = not useAiAdxFilter or aiAdx >= aiAdxMin

aiLongScore =
     (aiMlBull ? 25 : 0) +
     (aiKernelBull ? 15 : 0) +
     (aiSuperBull ? 15 : 0) +
     (aiMacdBull ? 15 : 0) +
     (aiRsiBull ? 10 : 0) +
     (aiTrendBull ? 10 : 0) +
     (aiVwapBull ? 5 : 0) +
     (aiHtfBull ? 5 : 0)

aiShortScore =
     (aiMlBear ? 25 : 0) +
     (aiKernelBear ? 15 : 0) +
     (aiSuperBear ? 15 : 0) +
     (aiMacdBear ? 15 : 0) +
     (aiRsiBear ? 10 : 0) +
     (aiTrendBear ? 10 : 0) +
     (aiVwapBear ? 5 : 0) +
     (aiHtfBear ? 5 : 0)

aiConfidence = math.max(aiLongScore, aiShortScore)
aiBias = aiLongScore > aiShortScore ? direction.long : aiShortScore > aiLongScore ? direction.short : direction.neutral
aiLongPass = not useAiConfluence or (aiBias == direction.long and aiConfidence >= aiMinConfidence and aiAdxPass and aiVolumePass)
aiShortPass = not useAiConfluence or (aiBias == direction.short and aiConfidence >= aiMinConfidence and aiAdxPass and aiVolumePass)
confirmedSignalBar = barstate.isconfirmed

aiFastPlot = plot(showAiCloud ? aiEmaFast : na, title="pivotsnap Fast EMA", color=color.new(#00C2A8, 0), linewidth=1)
aiSlowPlot = plot(showAiCloud ? aiEmaSlow : na, title="pivotsnap Slow EMA", color=color.new(#F25F5C, 0), linewidth=1)
aiCloudColor = aiBias == direction.long ? color.new(#00C2A8, 86) : aiBias == direction.short ? color.new(#F25F5C, 86) : color.new(color.gray, 92)
fill(aiFastPlot, aiSlowPlot, color=showAiCloud ? aiCloudColor : na, title="pivotsnap AI Trend Cloud")
plot(showSupertrendLine ? aiSupertrend : na, title="pivotsnap Supertrend", color=aiSuperBull ? color.new(#00C2A8, 0) : color.new(#F25F5C, 0), linewidth=2, style=plot.style_linebr)
bgcolor(showAiGlow ? (aiBias == direction.long ? color.new(#00C2A8, 94) : aiBias == direction.short ? color.new(#F25F5C, 94) : na) : na, title="pivotsnap AI Glow")

scanner_signal() =>
    _emaFast = ta.ema(close, aiFastEmaLen)
    _emaSlow = ta.ema(close, aiSlowEmaLen)
    [_macdLine, _macdSignalLine, _macdHist] = ta.macd(close, aiMacdFast, aiMacdSlow, aiMacdSignal)
    _rsi = ta.rsi(close, aiRsiLen)
    [_supertrend, _supertrendDirection] = ta.supertrend(aiStFactor, aiStPeriod)
    [_plusDi, _minusDi, _adx] = ta.dmi(aiAdxLen, aiAdxLen)
    _vwap = ta.vwap(hlc3)
    _trendBull = _emaFast > _emaSlow and close > _emaSlow
    _trendBear = _emaFast < _emaSlow and close < _emaSlow
    _superBull = _supertrendDirection < 0
    _superBear = _supertrendDirection > 0
    _macdBull = _macdHist > 0 and _macdLine > _macdSignalLine
    _macdBear = _macdHist < 0 and _macdLine < _macdSignalLine
    _rsiBull = _rsi >= 52
    _rsiBear = _rsi <= 48
    _vwapBull = not useAiVwapFilter or na(_vwap) or close > _vwap
    _vwapBear = not useAiVwapFilter or na(_vwap) or close < _vwap
    _adxPass = not useAiAdxFilter or _adx >= aiAdxMin
    _bullScore =
         (_trendBull ? 25 : 0) +
         (_superBull ? 25 : 0) +
         (_macdBull ? 20 : 0) +
         (_rsiBull ? 15 : 0) +
         (_vwapBull ? 5 : 0) +
         (_adxPass ? 10 : 0)
    _bearScore =
         (_trendBear ? 25 : 0) +
         (_superBear ? 25 : 0) +
         (_macdBear ? 20 : 0) +
         (_rsiBear ? 15 : 0) +
         (_vwapBear ? 5 : 0) +
         (_adxPass ? 10 : 0)
    _confidence = math.max(_bullScore, _bearScore)
    _buySetup = _bullScore >= scannerMinConfidence and _bullScore > _bearScore
    _sellSetup = _bearScore >= scannerMinConfidence and _bearScore > _bullScore
    _freshBuy = _buySetup and not _buySetup[1]
    _freshSell = _sellSetup and not _sellSetup[1]
    _state = _freshBuy ? 1 : _freshSell ? -1 : _buySetup ? 2 : _sellSetup ? -2 : 0
    [_state[1], _confidence[1], close[1]]

// ===========================
// ==== Entries and Exits ====
// ===========================

startLongTrade  = isNewBuySignal  and isBullish and isEmaUptrend   and isSmaUptrend   and aiLongPass  and confirmedSignalBar
startShortTrade = isNewSellSignal and isBearish and isEmaDowntrend and isSmaDowntrend and aiShortPass and confirmedSignalBar

lastSignalWasBullish = ta.barssince(startLongTrade)  < ta.barssince(startShortTrade)
lastSignalWasBearish = ta.barssince(startShortTrade) < ta.barssince(startLongTrade)
barsSinceRedEntry    = ta.barssince(startShortTrade)
barsSinceRedExit     = ta.barssince(alertBullish)
barsSinceGreenEntry  = ta.barssince(startLongTrade)
barsSinceGreenExit   = ta.barssince(alertBearish)
isValidShortExit     = barsSinceRedExit   > barsSinceRedEntry
isValidLongExit      = barsSinceGreenExit > barsSinceGreenEntry
endLongTradeDynamic  = (isBearishChange and isValidLongExit[1])
endShortTradeDynamic = (isBullishChange and isValidShortExit[1])

endLongTradeStrict  = ((isHeldFourBars and isLastSignalBuy)  or (isHeldLessThanFourBars and isNewSellSignal and isLastSignalBuy))  and startLongTrade[4]
endShortTradeStrict = ((isHeldFourBars and isLastSignalSell) or (isHeldLessThanFourBars and isNewBuySignal  and isLastSignalSell)) and startShortTrade[4]
isDynamicExitValid  = not useEmaFilter and not useSmaFilter and not useKernelSmoothing
endLongTradeRaw     = settings.useDynamicExits and isDynamicExitValid ? endLongTradeDynamic  : endLongTradeStrict
endShortTradeRaw    = settings.useDynamicExits and isDynamicExitValid ? endShortTradeDynamic : endShortTradeStrict
endLongTrade        = endLongTradeRaw and confirmedSignalBar
endShortTrade       = endShortTradeRaw and confirmedSignalBar

// ======================================
// ==== TP/SL Calculation (NEW) ====
// ======================================

atrValue = ta.atr(atrLength)

var float entryPrice = na
var float tpLevel    = na
var float slLevel    = na
var bool  inLong     = false
var bool  inShort    = false

if startLongTrade
    entryPrice := close
    tpLevel    := close + atrValue * atrMultTP
    slLevel    := close - atrValue * atrMultSL
    inLong     := true
    inShort    := false

if startShortTrade
    entryPrice := close
    tpLevel    := close - atrValue * atrMultTP
    slLevel    := close + atrValue * atrMultSL
    inLong     := false
    inShort    := true

if endLongTrade or endShortTrade
    inLong  := false
    inShort := false

// TP/SL hit detection
tpHitLong  = inLong  and high  >= tpLevel
slHitLong  = inLong  and low   <= slLevel
tpHitShort = inShort and low   <= tpLevel
slHitShort = inShort and high  >= slLevel

// Auto-clear levels when TP or SL is hit
if tpHitLong or slHitLong or tpHitShort or slHitShort
    inLong  := false
    inShort := false

// =========================
// ==== Plotting Labels ====
// =========================

plotshape(startLongTrade  ? low  : na, 'pivotsnap BUY',  shape.labelup,   location.belowbar, color=ml.color_green(prediction),  size=size.small, offset=0, text="BUY",  textcolor=color.black)
plotshape(startShortTrade ? high : na, 'pivotsnap SELL', shape.labeldown, location.abovebar, ml.color_red(-prediction),         size=size.small, offset=0, text="SELL", textcolor=color.white)
plotshape(endLongTrade  and settings.showExits ? high : na, 'StopBuy',  shape.xcross, location.absolute, color=#3AFF17, size=size.tiny, offset=0)
plotshape(endShortTrade and settings.showExits ? low  : na, 'StopSell', shape.xcross, location.absolute, color=#FD1707, size=size.tiny, offset=0)

// ============================================
// ============================================
// ==== Real-Time TP/SL Lines (NEW) ====
// ============================================

// Active-trade line/label handles (extended every bar while trade is open)
var line  activeTpLine  = na
var line  activeSlLine  = na
var line  activeEpLine  = na
var label activeTpLabel = na
var label activeSlLabel = na
var label activeEpLabel = na

// Draw fresh TP/SL set on every new signal
if showTPSL and (startLongTrade or startShortTrade)
    // Colors: long = green TP / red SL | short = red TP / green SL
    tpCol = startLongTrade ? color.new(#009988, 0) : color.new(#CC3311, 0)
    slCol = startLongTrade ? color.new(#CC3311, 0) : color.new(#009988, 0)
    epCol = color.new(color.gray, 30)

    // TP line
    activeTpLine := line.new(
     x1=bar_index, y1=tpLevel,
     x2=bar_index + 1, y2=tpLevel,
     color=tpCol,
     style=line.style_solid,
     width=2)

    // SL line
    activeSlLine := line.new(
     x1=bar_index, y1=slLevel,
     x2=bar_index + 1, y2=slLevel,
     color=slCol,
     style=line.style_solid,
     width=2)

    // Entry line
    if showEPLine
        activeEpLine := line.new(
         x1=bar_index, y1=entryPrice,
         x2=bar_index + 1, y2=entryPrice,
         color=epCol,
         style=line.style_dashed,
         width=1)

    // TP label
    activeTpLabel := label.new(
     x=bar_index + 1, y=tpLevel,
     text="TP  " + str.tostring(tpLevel, "#.####"),
     style=label.style_label_left,
     color=color.new(tpCol, 10),
     textcolor=color.white,
     size=size.small)

    // SL label
    activeSlLabel := label.new(
     x=bar_index + 1, y=slLevel,
     text="SL  " + str.tostring(slLevel, "#.####"),
     style=label.style_label_left,
     color=color.new(slCol, 10),
     textcolor=color.white,
     size=size.small)

    // Entry label
    if showEPLine
        activeEpLabel := label.new(
         x=bar_index + 1, y=entryPrice,
         text="Entry  " + str.tostring(entryPrice, "#.####"),
         style=label.style_label_left,
         color=color.new(color.gray, 20),
         textcolor=color.white,
         size=size.small)

// Extend active lines rightward on every bar while in a trade
if showTPSL and (inLong or inShort)
    if not na(activeTpLine)
        line.set_x2(activeTpLine, bar_index + 3)
        label.set_x(activeTpLabel, bar_index + 3)
    if not na(activeSlLine)
        line.set_x2(activeSlLine, bar_index + 3)
        label.set_x(activeSlLabel, bar_index + 3)
    if showEPLine and not na(activeEpLine)
        line.set_x2(activeEpLine, bar_index + 3)
        if not na(activeEpLabel)
            label.set_x(activeEpLabel, bar_index + 3)

