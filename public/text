    table.cell(indexScanner, 0, 0, "Indian Index", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)
    table.cell(indexScanner, 1, 0, "Signal", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)
