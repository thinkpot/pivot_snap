    table.cell(aiDash, 1, 1, str.tostring(aiConfidence, "#") + "%", text_color=color.white, bgcolor=ai_bias_color(aiBias), text_size=size.small)
    table.cell(aiDash, 0, 2, "Long / Short", text_color=color.gray, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(aiDash, 1, 2, str.tostring(aiLongScore, "#") + " / " + str.tostring(aiShortScore, "#"), text_color=color.white, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(aiDash, 0, 3, "ML Vote", text_color=color.gray, bgcolor=color.new(color.black, 15), text_size=size.small)
